// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  fullName       String
  mobile         String         @unique
  email          String         @unique
  passwordHash   String
  referralCode   String         @unique @default("")
  referredBy     String?
  referralBonus  Int            @default(0) // bonus in paise
  createdAt      DateTime       @default(now())
  applications   Application[]
  referralsGiven Referral[]     @relation("Referrer")
  referralsGot   Referral[]     @relation("ReferredUser")
  formRequests   FormRequest[]
  userNotifications UserNotification[]
}

model Exam {
  id                String         @id @default(cuid())
  title             String
  category          String
  officialFee       Int            // Amount in paise
  serviceFee        Int            // Amount in paise
  lastDate          DateTime
  requiredDocuments String
  description       String
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  applications      Application[]
}

model Application {
  id             String      @id @default(cuid())
  userId         String
  examId         String
  formData       String
  status         String @default("SUBMITTED")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  documents      Document[]
  payment        Payment?
  statusHistory  StatusHistory[]
  notes          Note[]
  otpRelays      OtpRelay[]
}

model Document {
  id           String      @id @default(cuid())
  applicationId String
  docType      String
  fileUrl      String
  uploadedAt   DateTime    @default(now())
  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String         @id @default(cuid())
  applicationId    String         @unique
  amount           Int            // Amount in paise
  razorpayOrderId  String         @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status           String @default("PENDING")
  createdAt        DateTime       @default(now())
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}


model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType String
  discountValue Int
  expiryDate   DateTime
  usageLimit   Int
  usedCount    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

model StatusHistory {
  id            String   @id @default(cuid())
  applicationId String
  oldStatus     String?
  newStatus     String
  changedBy     String   // 'admin', 'staff', 'system', or userId
  changedByName String
  note          String?
  createdAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Note {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String
  authorName    String
  authorRole    String   // 'admin', 'agent', 'user'
  content       String
  createdAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String
  code         String
  bonusAwarded Int      @default(0) // bonus in paise
  createdAt    DateTime @default(now())
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])
  referredUser User     @relation("ReferredUser", fields: [referredId], references: [id])
}


// OTP Verification records
model OtpVerification {
  id          String   @id @default(cuid())
  mobile      String
  otp         String   // Hashed OTP
  purpose     String   // 'SIGNUP', 'FORM_FILL', 'LOGIN'
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([mobile, purpose])
  @@index([expiresAt])
}

// User requests a form that is not listed in the catalog
model FormRequest {
  id            String   @id @default(cuid())
  userId        String
  formName      String   // Name of the form/exam
  category      String   // e.g., Government, College, Scholarship
  portalName    String?  // Official portal name/URL if known
  description   String?  // Any extra details
  contactNumber String   // User's phone for follow-up
  status        String   @default("PENDING") // PENDING, APPROVED, DECLINED, COMPLETED
  adminNote     String?  // Admin's response note
  estimatedFee  Int?     // Estimated service fee in paise
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User Notifications - In-app notifications for users
model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'WELCOME', 'FORM_SUBMITTED', 'PAYMENT_RECEIVED', 'STATUS_UPDATE', 'FORM_AVAILABLE'
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// Notifications - Activity tracking for admin dashboard
model Notification {
  id        String   @id @default(cuid())
  type      String   // 'SIGNUP', 'FORM_SUBMIT', 'PAYMENT', 'STATUS_CHANGE', 'FORM_REQUEST', 'OTP_RELAY'
  title     String   // Short title
  message   String   // Full message
  userId    String?  // Related user ID
  userName  String?  // User's name for display
  examName  String?  // Exam name if related
  amount    Int?     // Amount in paise if payment
  status    String   @default("UNREAD") // UNREAD, READ
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Contact Messages - From the contact form
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED, ARCHIVED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// OTP Relay - When admin/staff fills form on government portal and needs OTP from user
model OtpRelay {
  id              String   @id @default(cuid())
  applicationId   String
  portalName      String   // e.g., 'SSC', 'IBPS', 'Railway'
  requestedBy     String   // Admin name who requested
  requestedById   String   // Admin ID
  userMobile      String   // User's mobile number
  otp             String?  // The OTP submitted by user
  status          String   @default("PENDING") // PENDING, SUBMITTED, EXPIRED, CANCELLED
  smsSent         Boolean  @default(false)
  smsSentAt       DateTime?
  submittedAt     DateTime?
  expiresAt       DateTime // OTP request expires after 10 minutes
  createdAt       DateTime @default(now())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
}
