# ClickNsit — environment template.
# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase pooler URL in production).
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require"

# Signs NextAuth JWTs, mobile session tokens and password-reset links.
# Must be >= 24 chars. Production throws at runtime if it is missing or short.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public origin of the app. Used for auth callbacks and reset links.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional: separate admin cookie secret (falls back to NEXTAUTH_SECRET) ─────
# ADMIN_SESSION_SECRET="another-random-32-byte-secret"

# ── Optional: first admin created by `npm run seed` ───────────────────────────
# If ADMIN_SEED_PASSWORD is unset the seed generates a random password and prints
# it once. Change it later from Admin → Settings, or with `npm run admin:password`.
# ADMIN_SEED_EMAIL="admin@clickandsit.in"
# ADMIN_SEED_PASSWORD="set-a-strong-password"

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxx"

# ── Email (Gmail SMTP) — OTPs, reset links, application updates ───────────────
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="16-char-google-app-password"
APP_FROM_NAME="ClickNsit"

# ── SMS (MSG91) — optional, falls back to email/logging when unset ────────────
# MSG91_API_KEY=""
# MSG91_SENDER_ID="FORMES"
# MSG91_SMS_FLOW_ID=""

# ── Telegram bot + staff alerts (optional) ────────────────────────────────────
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# TELEGRAM_ADMIN_IDS="comma-separated-chat-ids"
# TELEGRAM_WEBHOOK_URL="https://your-domain.vercel.app/api/telegram/webhook"

# ── Mobile app (Expo) — only read by mobile/, not by the web app ──────────────
# EXPO_PUBLIC_API_URL="https://your-domain.vercel.app"
